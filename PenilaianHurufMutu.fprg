<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="PenilaianHurufMutu"/>
        <attribute name="authors" value="Aluna"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-21 09:59:37 AM"/>
        <attribute name="created" value="QWx1bmE7QUxVTkE7MjAyNi0wOS0yMTswOTozMjoyNyBBTTsyMTQw"/>
        <attribute name="edited" value="QWx1bmE7QUxVTkE7MjAyNi0wOS0yMTswOTo1OTozNyBBTTsxOzIyNTg="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nilai" type="Integer" array="False" size=""/>
            <output expression="&quot;Penilaian Huruf Mutu&quot;" newline="True"/>
            <output expression="&quot;Masukkan nilai! (0-100)&quot;" newline="True"/>
            <input variable="nilai"/>
            <if expression="nilai &lt; 0 or nilai &gt; 100">
                <then>
                    <output expression="&quot;Nilai tidak valid&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="nilai &gt;= 85">
                        <then>
                            <output expression="&quot;A&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="nilai &gt;= 70 &amp;&amp; nilai &lt; 85">
                                <then>
                                    <output expression="&quot;B&quot;" newline="True"/>
                                </then>
                                <else>
                                    <if expression="nilai &gt;= 55 &amp;&amp; nilai &lt; 70">
                                        <then>
                                            <output expression="&quot;C&quot;" newline="True"/>
                                        </then>
                                        <else>
                                            <if expression="nilai &gt;= 40 &amp;&amp; nilai &lt; 55">
                                                <then>
                                                    <output expression="&quot;D&quot;" newline="True"/>
                                                </then>
                                                <else>
                                                    <if expression="nilai &lt; 40">
                                                        <then>
                                                            <output expression="&quot;E&quot;" newline="True"/>
                                                        </then>
                                                        <else/>
                                                    </if>
                                                </else>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
